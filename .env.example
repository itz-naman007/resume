# Absolute public origin. Use http://localhost:3000 for local development.
SITE_URL=http://localhost:3000
# Required in production: file on a persistent, writable local disk (not /public).
DATABASE_PATH=./data/portfolio.sqlite
# Optional: set ONLY behind a proxy that strips and overwrites this header.
# One IP address, not an X-Forwarded-For chain. Blank uses a shared rate limit.
TRUSTED_IP_HEADER=
